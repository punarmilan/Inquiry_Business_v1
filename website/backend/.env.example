NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/inquiryexperts

JWT_ACCESS_SECRET=replace-with-a-long-random-admin-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-admin-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Repeated manual QA without 429 blocks. Active ONLY when NODE_ENV is not
# "production" — production never bypasses, even if this is set.
DISABLE_RATE_LIMIT=false

PLATFORM_COMMISSION_RATE=0.1
