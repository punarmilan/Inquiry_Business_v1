NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/inquiryexperts

JWT_ACCESS_SECRET=replace-with-a-long-random-mobile-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-mobile-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=10
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-a-long-random-otp-pepper

CORS_ORIGIN=*
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=50

# Repeated manual QA without 429 blocks. Active ONLY when NODE_ENV is not
# "production" — production never bypasses, even if this is set.
DISABLE_RATE_LIMIT=false

PLATFORM_COMMISSION_RATE=0.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_WEB_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cloudinary stores every image uploaded from the app (profile photos, business
# logo/cover, offer photos and card designs). Use the same account as
# website/backend. Server-side only — never expose the API secret to the app.
# Without these, saving an image returns 503 CLOUDINARY_NOT_CONFIGURED.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay powers plan purchases (Business Plans screen). rzp_test_* keys create
# test-mode payments (fake cards); real money needs rzp_live_* keys. The secret is
# server-side only. Without these the app falls back to the old manual flow
# (order created, admin verifies later).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
