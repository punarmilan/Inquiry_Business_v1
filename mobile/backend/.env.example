NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/inquiryexperts

JWT_ACCESS_SECRET=replace-with-a-long-random-mobile-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-mobile-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=10
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-a-long-random-otp-pepper

CORS_ORIGIN=*
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=50

# Repeated manual QA without 429 blocks. Active ONLY when NODE_ENV is not
# "production" — production never bypasses, even if this is set.
DISABLE_RATE_LIMIT=false

PLATFORM_COMMISSION_RATE=0.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_WEB_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
